# =============================================================================
# DevGodzilla — Environment Variables Reference
# Copy this file to .env and fill in your values.
# Variables marked [required] must be set for the application to start.
# Variables marked [optional] have sensible defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# ## Database
# -----------------------------------------------------------------------------
# SQLite (default for development):
DEVGODZILLA_DB_PATH=.devgodzilla.sqlite            # [optional] SQLite DB file path
# PostgreSQL (recommended for production):
# DEVGODZILLA_DB_URL=postgresql://devgodzilla:password@localhost:5432/devgodzilla_db  # [optional] Full DB URL

# Test database:
# DEVGODZILLA_TEST_DB_URL=sqlite:///tmp/test_devgodzilla.sqlite      # [optional] Test DB URL

# Legacy alias (pre-rename):
# TASKSGODZILLA_DB_URL=                                              # [optional] Alias for DEVGODZILLA_DB_URL
# TASKSGODZILLA_DB_PATH=                                             # [optional] Alias for DEVGODZILLA_DB_PATH

# -----------------------------------------------------------------------------
# ## Redis
# -----------------------------------------------------------------------------
# DEVGODZILLA_REDIS_URL=redis://localhost:6379/0                     # [optional] Redis URL for queues/cache

# -----------------------------------------------------------------------------
# ## API Server
# -----------------------------------------------------------------------------
PORT=8000                                             # [optional] API server port (default: 8000)
DEVGODZILLA_LOG_LEVEL=INFO                            # [optional] Log level: DEBUG, INFO, WARNING, ERROR
DEVGODZILLA_CORS_ORIGINS=http://localhost:3000        # [optional] Comma-separated allowed CORS origins

# -----------------------------------------------------------------------------
# ## Authentication
# -----------------------------------------------------------------------------
DEVGODZILLA_API_TOKEN=                                # [optional] Static API token for webhook auth
DEVGODZILLA_JWT_SECRET=change-me-to-a-random-string   # [required] Secret for JWT token signing
DEVGODZILLA_JWT_REFRESH_ROTATE=true                   # [optional] Rotate refresh tokens (default: true)
DEVGODZILLA_SESSION_SECRET=change-me-to-random-string  # [optional] Secret for session cookies
DEVGODZILLA_SESSION_COOKIE_SECURE=false               # [optional] Set true in production with HTTPS

# Admin user (created on first startup):
DEVGODZILLA_ADMIN_USERNAME=admin                      # [optional] Default admin username
DEVGODZILLA_ADMIN_PASSWORD=                           # [optional] Default admin password (auto-generated if empty)
DEVGODZILLA_ADMIN_PASSWORD_HASH=                      # [optional] Pre-hashed admin password (overrides above)

# OIDC/SSO:
# DEVGODZILLA_OIDC_ISSUER=                                            # [optional] OIDC issuer URL (e.g., https://keycloak.example.com/realms/myrealm)
# DEVGODZILLA_OIDC_CLIENT_ID=                                         # [optional] OIDC client ID
# DEVGODZILLA_OIDC_CLIENT_SECRET=                                     # [optional] OIDC client secret

# -----------------------------------------------------------------------------
# ## AI / LLM Providers
# -----------------------------------------------------------------------------
# OpenAI:
# OPENAI_API_KEY=sk-...                                               # [optional] OpenAI API key

# Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...                                        # [optional] Anthropic API key

# Google Gemini:
# GOOGLE_API_KEY=                                                     # [optional] Google AI API key
# GEMINI_API_KEY=                                                     # [optional] Alias for Google AI

# Alibaba Qwen / DashScope:
# DASHSCOPE_API_KEY=                                                  # [optional] DashScope API key
# QWEN_API_KEY=                                                       # [optional] Qwen API key

# Amazon Q:
# AMAZON_Q_TOKEN=                                                     # [optional] Amazon Q auth token
# AWS_ACCESS_KEY_ID=                                                  # [optional] AWS access key
# AWS_PROFILE=                                                        # [optional] AWS profile name

# Qoder:
# QODER_API_KEY=                                                      # [optional] Qoder API key
# QODER_TOKEN=                                                        # [optional] Qoder auth token

# Augment:
# AUGMENT_API_KEY=                                                    # [optional] Augment API key
# AUGMENT_TOKEN=                                                      # [optional] Augment auth token

# GitHub Copilot:
# GH_TOKEN=                                                           # [optional] GitHub token for Copilot

# -----------------------------------------------------------------------------
# ## Agent / Engine Configuration
# -----------------------------------------------------------------------------
# Each pipeline stage can use a different engine and model:
DEVGODZILLA_DEFAULT_ENGINE_ID=                       # [optional] Global engine default for Docker/API/CLI fallback
DEVGODZILLA_DISCOVERY_ENGINE_ID=                     # [optional] Engine for discovery phase (e.g., "opencode", "claude_code")
DEVGODZILLA_SPECKIT_ENGINE_ID=                       # [optional] Engine for spec generation
DEVGODZILLA_PLANNING_ENGINE_ID=                      # [optional] Engine for planning phase
DEVGODZILLA_EXEC_ENGINE_ID=                          # [optional] Engine for execution phase
DEVGODZILLA_QA_ENGINE_ID=                            # [optional] Engine for QA phase

# Model overrides per stage:
DEVGODZILLA_SPECKIT_MODEL=                           # [optional] Model for spec generation
DEVGODZILLA_DECOMPOSE_MODEL=                         # [optional] Model for task decomposition
DEVGODZILLA_PLANNING_MODEL=                          # [optional] Model for planning
DEVGODZILLA_EXEC_MODEL=                              # [optional] Model for execution
DEVGODZILLA_QA_MODEL=                                # [optional] Model for QA
DEVGODZILLA_OPENCODE_MODEL=                          # [optional] Model for OpenCode engine

# Token limits:
DEVGODZILLA_MAX_TOKENS_PER_PROTOCOL=500000           # [optional] Max tokens per protocol run
DEVGODZILLA_MAX_TOKENS_PER_STEP=50000                # [optional] Max tokens per step

# QA settings:
DEVGODZILLA_AUTO_QA_AFTER_EXEC=false                 # [optional] Auto-run QA after execution
DEVGODZILLA_AUTO_QA_ON_CI=false                      # [optional] Auto-run QA in CI mode
DEVGODZILLA_QA_AUTO_FIX_ENABLED=false                # [optional] Auto-fix QA failures
DEVGODZILLA_SPEC_AUDIT_INTERVAL_SECONDS=300          # [optional] Spec audit interval

# Sandbox:
DEVGODZILLA_SANDBOX_TYPE=local                       # [optional] Sandbox type: "local", "docker"

# Git worktree:
DEVGODZILLA_SINGLE_WORKTREE=false                    # [optional] Use single worktree instead of per-task
DEVGODZILLA_SKIP_SIMPLE_DECOMPOSE=false              # [optional] Skip decomposition for simple specs
DEVGODZILLA_AGENT_CONFIG_PATH=                       # [optional] Path to agent config YAML
INSTALL_AGENT_CLIS=1                                 # [optional] Install CLI agents into Docker image for compose runs

# Speckit source:
DEVGODZILLA_SPECKIT_SOURCE=                          # [optional] Speckit source override

# -----------------------------------------------------------------------------
# ## Windmill (Workflow Engine)
# -----------------------------------------------------------------------------
# DEVGODZILLA_WINDMILL_URL=http://localhost:8000                     # [optional] Windmill server URL
# DEVGODZILLA_WINDMILL_TOKEN=                                         # [optional] Windmill API token
# DEVGODZILLA_WINDMILL_WORKSPACE=main                                 # [optional] Windmill workspace
# DEVGODZILLA_WINDMILL_ENV_FILE=                                      # [optional] Windmill env file path
# DEVGODZILLA_WINDMILL_IMPORT_MANIFEST=                               # [optional] Windmill import manifest path
# DEVGODZILLA_LIVE_WINDMILL_REPO_BRANCH=main                          # [optional] Branch for live Windmill repo

# Internal (set by Windmill at runtime):
# WM_BASE_URL=                                                        # [internal] Windmill base URL
# WM_TOKEN=                                                           # [internal] Windmill token
# WM_WORKSPACE=                                                       # [internal] Windmill workspace
# WM_JOB_ID=                                                          # [internal] Current job ID
# WM_JOB_PATH=                                                        # [internal] Current job path
# WM_RUNNABLE_ID=                                                     # [internal] Runnable ID
# WM_FLOW_JOB_ID=                                                     # [internal] Flow job ID
# WM_FLOW_STEP_ID=                                                    # [internal] Flow step ID
# WM_ROOT_FLOW_JOB_ID=                                                # [internal] Root flow job ID
# WM_STATE_PATH=                                                      # [internal] State path
# WM_MOCKED_API_FILE=                                                 # [internal] Mocked API file

# -----------------------------------------------------------------------------
# ## GitHub / GitLab Integration
# -----------------------------------------------------------------------------
# GITHUB_TOKEN=                                                        # [optional] GitHub personal access token
# GITLAB_TOKEN=                                                        # [optional] GitLab personal access token
# DEVGODZILLA_WEBHOOK_TOKEN=                                           # [optional] Webhook verification token

# Git identity:
# TASKSGODZILLA_GIT_USER=DevGodzilla Bot                              # [optional] Git commit author name
# TASKSGODZILLA_GIT_EMAIL=bot@devgodzilla.dev                         # [optional] Git commit author email

# -----------------------------------------------------------------------------
# ## Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000        # [optional] Backend API URL exposed to browser
NEXT_PUBLIC_API_URL=http://localhost:8000             # [optional] Alternative API URL (legacy)
NEXT_PUBLIC_BASE_PATH=/console                        # [optional] Next.js basePath
FRONTEND_PORT=3000                                    # [optional] Frontend dev server port
NODE_ENV=development                                  # [optional] development | production | test
NEXT_ALLOWED_DEV_ORIGINS=                             # [optional] Additional allowed dev origins

# Codex CLI:
# CODEX_CLI_PATH=                                                     # [optional] Path to Codex CLI binary

# -----------------------------------------------------------------------------
# ## Testing
# -----------------------------------------------------------------------------
# DEVGODZILLA_RUN_E2E=0                                               # [optional] Enable E2E tests (default: 0)
# DEVGODZILLA_RUN_E2E_HARNESS=0                                       # [optional] Enable E2E harness tests
# DEVGODZILLA_RUN_E2E_REAL_AGENT=0                                    # [optional] Enable real agent E2E tests
# RUN_REAL_CODEX=0                                                     # [optional] Enable real Codex CLI tests
# DEVGODZILLA_TEST_SPECKIT_ENGINE_ID=dummy                            # [optional] Engine for test Speckit
# DEVGODZILLA_TEST_SPECKIT_MODEL=dummy                                # [optional] Model for test Speckit
# HARNESS_API_BASE_URL=                                               # [optional] Test harness API URL
# HARNESS_GITHUB_OWNER=                                               # [optional] Test harness GitHub owner
# HARNESS_GITHUB_REPOS=                                               # [optional] Test harness GitHub repos
# HARNESS_REPO_URL_OVERRIDE=                                          # [optional] Override repo URL in harness
# HARNESS_SCENARIO=                                                   # [optional] Test scenario name
# HARNESS_SPECKIT_DESCRIPTION=                                        # [optional] Spec description for harness
# HARNESS_SPECKIT_CLARIFY_QUESTION=                                   # [optional] Clarification question
# HARNESS_SPECKIT_CLARIFY_ANSWER=                                     # [optional] Clarification answer

# -----------------------------------------------------------------------------
# ## Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317                   # [optional] OTLP exporter endpoint

# -----------------------------------------------------------------------------
# ## Observability (Sentry)
# -----------------------------------------------------------------------------
# DEVGODZILLA_SENTRY_DSN=                                              # [optional] Sentry DSN (unset = disabled)
# DEVGODZILLA_SENTRY_TRACES_SAMPLE_RATE=0.2                            # [optional] Traces sample rate 0.0–1.0
# DEVGODZILLA_SENTRY_PROFILES_SAMPLE_RATE=0.1                          # [optional] Profiles sample rate 0.0–1.0
# NEXT_PUBLIC_SENTRY_DSN=                                              # [optional] Frontend Sentry DSN (unset = disabled)
# NEXT_PUBLIC_SENTRY_RELEASE=                                          # [optional] Frontend release tag
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2                            # [optional] Frontend traces sample rate

# -----------------------------------------------------------------------------
# ## CI/CD
# -----------------------------------------------------------------------------
# CI=false                                                             # [internal] Set by CI runners
# DEVGODZILLA_CI_MODE=0                                                # [optional] CI-specific behavior flag
# MAIN_OVERRIDE=                                                       # [optional] Override main branch name
# OPENCODE_E2E_LOG=                                                    # [optional] OpenCode E2E log path

# -----------------------------------------------------------------------------
# ## Legacy (TasksGodzilla → DevGodzilla migration)
# -----------------------------------------------------------------------------
# All TASKSGODZILLA_* variables are legacy aliases. Use DEVGODZILLA_* instead.
# TASKSGODZILLA_ADMIN_USERNAME=admin
# TASKSGODZILLA_ADMIN_PASSWORD=
# TASKSGODZILLA_API_TOKEN=
# TASKSGODZILLA_JWT_SECRET=
# TASKSGODZILLA_SESSION_SECRET=
# TASKSGODZILLA_DISCOVERY_ENGINE_ID=
# TASKSGODZILLA_EXEC_ENGINE_ID=
# TASKSGODZILLA_EXEC_TIMEOUT_SECONDS=300
# TASKSGODZILLA_NON_INTERACTIVE=0
# TASKSGODZILLA_LOG_LEVEL=INFO
# TASKSGODZILLA_MAX_TOKENS_PER_PROTOCOL=500000
# TASKSGODZILLA_MAX_TOKENS_PER_STEP=50000
# TASKSGODZILLA_PLANNING_ENGINE_ID=
# TASKSGODZILLA_QA_ENGINE_ID=
# TASKSGODZILLA_REDIS_URL=redis://localhost:6379/0
# TASKSGODZILLA_SPEC_AUDIT_INTERVAL_SECONDS=300
# TASKSGODZILLA_WEBHOOK_TOKEN=
# TASKSGODZILLA_WINDMILL_TOKEN=
# TASKSGODZILLA_WINDMILL_URL=
